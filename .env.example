APP_ENV=local
HOST=0.0.0.0
PORT=8001
LOG_LEVEL=info

CORS_ORIGINS=http://localhost:5173

GROQ_API_KEY=
GROQ_API_BASE=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

CHROMA_PERSIST_DIR=./chroma_data

# Same database as the Laravel app (RapportDrive_b/.env DB_* values) —
# the chat agent's tools read from it directly.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rapportdrive
DB_USERNAME=root
DB_PASSWORD=
# Set true for managed MySQL providers that enforce TLS (e.g. Aiven).
# DB_SSL=true
# Optional: verify against a CA file instead (takes precedence over DB_SSL).
# DB_SSL_CA=./certs/aiven-ca.pem
